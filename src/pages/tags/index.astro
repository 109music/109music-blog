---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, SECTIONS, TAGS, url } from '../../lib/site';

const counts = new Map<string, number>();
for (const s of SECTIONS) {
  const entries = await getCollection(s.id as any);
  for (const e of entries) {
    if (e.data.draft) continue;
    for (const t of e.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}

const description =
  'Browse 109MUSIC by topic: Spotify growth, TikTok, Instagram, release strategy, touring, revenue and the rest of the music business.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Topics',
  description,
  url: new URL(url('/tags/'), Astro.site).href,
  hasPart: TAGS.filter((t) => (counts.get(t.slug) ?? 0) > 0).map((t) => ({
    '@type': 'CollectionPage',
    name: t.label,
    url: new URL(url(`/tags/${t.slug}/`), Astro.site).href,
  })),
};
---
<Base title="Topics" description={description} activeSection="tags" schema={schema}>
  <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · Browse</p>
      <h1 class="display rise">BY<br /><span class="lav">TOPIC</span></h1>
      <p class="sub rise">
        Sections tell you what kind of piece it is. Topics tell you what it is about.
        Ten of them, and every article carries at least one.
      </p>
    </section>

    <ul class="tagcloud">
      {TAGS.map((t) => {
        const n = counts.get(t.slug) ?? 0;
        return (
          <li class={n ? '' : 'off'}>
            <a href={url(`/tags/${t.slug}/`)} aria-disabled={n ? undefined : 'true'}>
              <span class="name">{t.label}</span>
              <span class="blurb">{t.blurb}</span>
              <span class="count">{n === 0 ? 'Nothing yet' : `${n} ${n === 1 ? 'article' : 'articles'}`}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
