---
import Base from '../../layouts/Base.astro';
import { url, wa } from '../../lib/site';
/* Filled in Phase 2 from the Beacons inventory. Nothing is invented here: if the
   catalogue is empty the page says so rather than showing placeholder products. */
const PRODUCTS: { name: string; line: string; price: string; href: string; free: boolean }[] = [];
---
<Base title="Resources" description="Guides, templates and playbooks for independent artists from 109MUSIC." activeSection="resources">
  <div class="lightband">
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · Resources</p>
      <h1 class="display rise">Resources</h1>
      <p class="sub rise">Every guide, template and playbook in one place. Some free, some paid.</p>
    </section>
   </div>
  </div>

  <div class="wrap">
    <section>
      {PRODUCTS.length ? (
        <ul class="rows">
          {PRODUCTS.map((p, i) => (
            <li class="row"><a href={p.href}>
              <span class="rowmain"><span class="ttl">{p.name}</span><p class="dek">{p.line}</p></span>
              <span class="meta"><span>{p.free ? 'Free' : p.price}</span></span>
            </a></li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          The catalogue is being moved across from Beacons. In the meantime everything is
          still available there.
        </p>
      )}
      <a class="btn" href="https://beacons.ai/109music.co" target="_blank" rel="noopener" style="margin-top:22px">
        <span>109MUSIC on Beacons</span><span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</Base>
