---
/* RESULTS — the commercial proof page, and the first thing in the header.
   Distinct from Case Studies in every way that matters: these are OUR campaigns, with
   numbers we measured, for artists who gave permission. Case Studies are other people's
   rollouts reconstructed from public information. The two never share a word.

   Nothing renders publicly until RESULTS_LIVE is true and RESULTS has real data. Until
   then the page tells the truth instead of showing invented figures. */
import Base from '../../layouts/Base.astro';
import ResultCard from '../../components/ResultCard.astro';
import SectionMarker from '../../components/SectionMarker.astro';
import Compare from '../../components/Compare.astro';
import { wa, RESULTS_LIVE, RESULTS, SHOW_RESULTS } from '../../lib/site';

/* `live` cuelga tambien del interruptor. Esconder Results y dejar las tarjetas
   visibles a quien escriba la URL seria esconderlo a medias. */
const live = SHOW_RESULTS && RESULTS_LIVE && RESULTS.length > 0;
const description =
  'Real campaign numbers from 109MUSIC: streams added, followers gained and the baseline each one started from.';
---
{/* Con el interruptor apagado: noindex para que salga del indice de Google sin
    devolver un 404 en una URL que ya esta en el sitemap, y `data-pagefind-ignore`
    para que el buscador del sitio no la ofrezca. La pagina sigue existiendo y
    sigue diciendo la verdad a quien escriba la URL a mano. */}
<Base title="Results" description={description} activeSection="results" noindex={!SHOW_RESULTS}>

  <div class="slab slab--tight" data-pagefind-ignore={!SHOW_RESULTS ? "all" : undefined}>
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · Client results</p>
      <h1 class="display face rise">Real artists.<br /><span class="lav">Real numbers.</span></h1>
      <p class="sub rise">
        {live
          ? 'Every figure below is a campaign we ran, measured against the week before it started. No rounding up, no screenshots without a baseline.'
          : 'This page is where our own campaign numbers go. It is empty on purpose until there are enough of them, and until every artist has signed off on hers.'}
      </p>
      <div class="hero-cta rise">
        <a class="btn" href={wa('results')} target="_blank" rel="noopener">
          <span>Get numbers like these</span><span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
   </div>
  </div>

  <div class="wrap">
    <section class="surf-bone">
      <SectionMarker n={1} slug="client_results" />
      {live ? (
        <>
          <div class="sec-head"><h2 class="display">Campaigns we have run</h2></div>
          <div class="rcard-grid">
            {RESULTS.map((r) => <ResultCard data={r} />)}
          </div>
        </>
      ) : (
        <>
          <div class="sec-head"><h2 class="display">Not published yet</h2></div>
          <p class="sec-intro">
            We are collecting written permission from the artists before any of this goes
            public, and we are not putting a number on this page that we cannot show the
            baseline for. If you want to see the work in the meantime, ask and we will
            walk you through a campaign directly.
          </p>
          <a class="btn" href={wa('results')} target="_blank" rel="noopener" style="margin-top:20px">
            <span>Ask to see a campaign</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </>
      )}
    </section>

    {/* La comparativa solo se monta aqui cuando Results esta VISIBLE. Con el
        interruptor apagado esta pagina no la ve nadie, asi que la tabla se muda
        sola a la home y no queda escondida detras de un noindex. */}
    {SHOW_RESULTS && (
      <section class="surf-bone">
        <SectionMarker n={2} slug="the_alternatives" />
        <div class="sec-head"><h2 class="display">What most artists try first</h2></div>
        <Compare />
      </section>
    )}
  </div>

  <div class="slab slab--tight">
    <div class="wrap">
      <section class="workband">
        <p class="mono">Bespoke work</p>
        <h2 class="display face">Tell us what you are putting out.</h2>
        <p class="workband-line">
          We will tell you straight whether we can move it, and what it would cost.
        </p>
        <a class="btn" href={wa('results')} target="_blank" rel="noopener">
          <span>Message us on WhatsApp</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="workband-fine mono">Replies from a person, usually same day</p>
      </section>
    </div>
  </div>
</Base>
