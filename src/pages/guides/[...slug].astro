---
/* Retired 2026-08-12: /guides/<slug>/ -> /music-marketing/<slug>/.
   Driven by LEGACY_GUIDE_SLUGS, not by the live collection, so these stubs keep
   working even if an article is later renamed, moved or unpublished. */
import Redirect from '../../layouts/Redirect.astro';
import { LEGACY_GUIDE_SLUGS, url } from '../../lib/site';

export function getStaticPaths() {
  return LEGACY_GUIDE_SLUGS.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
---
<Redirect to={url(`/music-marketing/${slug}/`)} label="Music Marketing" />
