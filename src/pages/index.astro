---
/* THE HOME PAGE, rebuilt 2026-08-14 around one sentence:
   "your number one source to market your music."

   The front page exists to sell, not to display the catalogue. Everything that was a
   shelf — the moment jumper, the news wire, the marketing shelf, the case-studies
   shelf, the business bridge, the topic cloud — is gone from here and lives inside
   Learn and its sections. What is left is five blocks.

   The thesis resolves the question we kept going round on, which was where the
   editorial half belongs. It is not a second front door and it is not a lower
   priority: it is one of the three things we offer, sitting in the same shelf as the
   paid work. An artist can learn it free or hand it over, and both routes are ours.
   That is what "all in one" has to look like structurally, not just in a strapline. */
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import ResultCard from '../components/ResultCard.astro';
import SectionMarker from '../components/SectionMarker.astro';
import Ambient from '../components/Ambient.astro';
import { getCollection } from 'astro:content';
import {
  SITE, SECTIONS, url, readingTime, labelOf, wa, pathOf, RESULTS_LIVE, RESULTS,
} from '../lib/site';

const live = (arr: any[]) =>
  arr.filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Latest reads across EVERY collection on purpose. It is now the only editorial block
   on the home, so it is also the only place News, Case Studies and Business content
   can surface here — a single-collection feed would have quietly orphaned three
   sections the moment the shelves came out. */
const everything: any[] = [];
for (const s of SECTIONS) {
  for (const e of live(await getCollection(s.id as any))) everything.push(e);
}
everything.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = everything.slice(0, 6);

const resultsLive = RESULTS_LIVE && RESULTS.length > 0;

/* Light bands alternate from a counter so toggling the results block cannot leave two
   identical surfaces touching. */
let surfN = 0;
const surf = () => (surfN++ % 2 === 0 ? 'surf-bone' : 'surf-tint');
let markN = 0;
const mark = () => ++markN;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      url: new URL(url('/'), Astro.site).href,
      description: SITE.description,
      sameAs: [SITE.instagram, SITE.beacons],
    },
    {
      '@type': 'WebSite',
      name: SITE.name,
      url: new URL(url('/'), Astro.site).href,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@type': 'Organization', name: SITE.name },
    },
  ],
};
---
<Base title={SITE.name} description={SITE.description} schema={schema}>

  {/* 01 · Hero */}
  <div class="slab band-fx">
    <img class="herobg" src={url('/img/hero-spectrum.webp')} alt="" width="1920" height="1080"
         fetchpriority="high" decoding="async" />
    <span class="stars" aria-hidden="true"></span>
    <span class="herobg-scrim" aria-hidden="true"></span>
    <div class="wrap">
      <section class="hero home-hero">
        <p class="kicker mono rise">Independent music marketing · Madrid</p>
        <h1 class="display face rise brandline">109MUSIC.CO</h1>
        <p class="statement rise">
          Your number one source to market your music. <b>Learn it free</b> in the
          playbooks, or <b>hand us the campaign</b> and we run it for you.
        </p>
        <div class="hero-cta rise">
          <a class="btn" href={wa('home')} target="_blank" rel="noopener">
            <span>Talk to us on WhatsApp</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn ghost" href={url('/music-marketing/')}>
            <span>Start with the playbooks</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </div>
  </div>

  <div class="wrap">

    {/* 02 · Client results. Behind RESULTS_LIVE until real figures exist — a visitor
        must never see an invented number on this page. */}
    {resultsLive && (
      <section class={surf()}>
        <Ambient />
        <SectionMarker n={mark()} slug="client_results" />
        <div class="sec-head">
          <h2 class="display">Real artists. Real numbers.</h2>
          <a href={url('/results/')}>All results →</a>
        </div>
        <p class="sec-intro">
          Every figure measured against the week before the campaign started.
        </p>
        <div class="rcard-grid">
          {RESULTS.slice(0, 4).map((r) => <ResultCard data={r} />)}
        </div>
      </section>
    )}

    {/* 03 · What we got for you. Three routes, one shelf. The free one sits first and
        at the same weight as the paid ones, which is the whole argument: the writing
        is not a lead magnet bolted onto an agency, it is proof that the agency knows
        what it is doing. */}
    <section class={surf()}>
      <Ambient />
      <SectionMarker n={mark()} slug="what_we_got_for_you" />
      <div class="sec-head">
        <h2 class="display">What we got for you</h2>
      </div>
      <p class="sec-intro">
        Whether you run it yourself or we run it, it is the same method. The difference
        is who does the work.
      </p>

      <div class="offergrid">
        <div class="offer">
          <p class="offer-tag mono">Free · Do it yourself</p>
          <h3 class="display">The playbooks</h3>
          <p>
            Everything we run for clients, written down with the real budgets, radiuses
            and thresholds. Organised by how close your record is, not by topic.
          </p>
          <ul class="ticks">
            <li>Release and tour playbooks</li>
            <li>Platform changes and what they cost you</li>
            <li>Famous rollouts taken apart</li>
          </ul>
          <a class="offer-cta mono" href={url('/music-marketing/')}>Read the playbooks →</a>
        </div>

        <div class="offer offer--lead">
          <p class="offer-tag mono">Paid · We run it</p>
          <h3 class="display">Meta ads &amp; playlisting</h3>
          <p>
            A person builds, watches and adjusts your campaign. Not a dashboard, not a
            preset. You get the reporting in plain language and you keep the pixel.
          </p>
          <ul class="ticks">
            <li>Release and tour campaigns on Meta</li>
            <li>Curator pitching, one track at a time</li>
            <li>Weekly reporting, no retainer lock-in</li>
          </ul>
          <a class="offer-cta mono" href={url('/services/')}>See how we work →</a>
        </div>

        <div class="offer">
          <p class="offer-tag mono">Tools</p>
          <h3 class="display">Templates &amp; track submission</h3>
          <p>
            The spreadsheets, checklists and templates we use internally, plus a way to
            put a single track in front of real curators for a fixed price.
          </p>
          <ul class="ticks">
            <li>Release planning templates</li>
            <li>Budget and break-even sheets</li>
            <li>Submit your track · 5 EUR</li>
          </ul>
          <a class="offer-cta mono" href={url('/resources/')}>Browse the resources →</a>
        </div>
      </div>
    </section>

    {/* 04 · Latest, across every collection */}
    {latest.length > 0 && (
      <section class={surf()}>
        <Ambient />
        <SectionMarker n={mark()} slug="latest" />
        <div class="sec-head">
          <h2 class="display">Latest</h2>
          <a href={url('/rss.xml')}>Subscribe via RSS →</a>
        </div>
        <ul class="rows">
          {latest.map((e) => (
            <Row
              href={pathOf(e.collection, e.id)}
              title={e.data.title}
              dek={e.data.dek}
              date={e.data.date}
              label={labelOf(e.collection)}
              minutes={readingTime(e.body)}
              showLabel={true}
            />
          ))}
        </ul>
      </section>
    )}

    {/* 05 · The alternatives, last. It is the closing argument, not the opening one:
        it only lands once someone has seen the numbers and the offer. */}
    <section class={surf()}>
      <Ambient />
      <SectionMarker n={mark()} slug="the_alternatives" />
      <div class="sec-head"><h2 class="display">What most artists try first</h2></div>
      <p class="sec-intro">
        Four ways to spend money on a release. Three of them we would talk you out of.
      </p>
      <div class="cmp-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th class="cmp-lab"><span class="visually-hidden">Comparison</span></th>
              <th>Paid playlist placements</th>
              <th>Agency retainer</th>
              <th>Running ads yourself</th>
              <th class="cmp-us">109MUSIC</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th class="cmp-lab" scope="row">What you get</th>
              <td>Streams from accounts that never come back</td>
              <td>A deck, monthly</td>
              <td>Reach, if the targeting is right</td>
              <td class="cmp-us">Listeners who save and follow</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">What it costs</th>
              <td>Per placement, with no floor</td>
              <td>Monthly retainer, three-month minimum</td>
              <td>Ad spend plus your own week</td>
              <td class="cmp-us">Ad spend plus one flat fee</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">Who keeps the pixel</th>
              <td>Not applicable</td>
              <td>Usually the agency</td>
              <td>You</td>
              <td class="cmp-us">You, always</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">Risk to the release</th>
              <td>Bot flags and playlist removal</td>
              <td>Slow to react mid-campaign</td>
              <td>Budget burnt learning</td>
              <td class="cmp-us">We publish our method — read it before you pay</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="cmp-foot mono">
        The last row is the whole argument. Everything under
        {' '}<a href={url('/music-marketing/')}>the playbooks</a> is what we run for
        clients, written down.
      </p>
    </section>
  </div>

  {/* 06 · Close */}
  <div class="slab band-fx">
    <span class="stars" aria-hidden="true"></span>
    <div class="wrap">
      <section class="workband">
        <p class="mono">Bespoke work</p>
        <h2 class="display face">Tell us what you are putting out.</h2>
        <p class="workband-line">
          We will tell you straight whether we can move it, and what it would cost.
          If the honest answer is that you should run it yourself, we will say that too.
        </p>
        <a class="btn" href={wa('home')} target="_blank" rel="noopener">
          <span>Message us on WhatsApp</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="workband-fine mono">Replies from a person, usually same day</p>
      </section>
    </div>
  </div>
</Base>
