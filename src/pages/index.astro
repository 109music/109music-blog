---
/* LA HOME, rediseñada 2026-08-14 (pase 4).

   Siete bloques, en el orden que fija la conversión y no el catálogo:
   hero · resultados · lo que ofrecemos · cómo trabajamos · aprende gratis ·
   lo que ya has probado · cierre.

   Dos cambios de sistema entran aquí:

   1. SE ACABÓ EL TERCER NIVEL DE SUPERFICIE. El tinte existía para que dos bandas
      claras seguidas no se leyeran igual. Con los listados sobre negro ese trabajo
      ya lo hace el contraste, así que la separación pasa a ser AIRE: dos bloques
      claros consecutivos abren más padding entre ellos (.surf-bone + .surf-bone).
      Dos superficies, negro y hueso, y nada intermedio.

   2. EL BLOQUE EDITORIAL ES UN ESCAPARATE, NO UN ARCHIVO. Tres artículos como
      máximo y tres enlaces de sección encima. Los enlaces son <a> reales, no
      filtros en cliente: con tres artículos un filtro no revela nada, y un enlace
      reparte autoridad hacia News, Music Marketing y Business. Coste en JS: cero.
*/
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import ResultCard from '../components/ResultCard.astro';
import ResultNote from '../components/ResultNote.astro';
import SectionMarker from '../components/SectionMarker.astro';
import Ambient from '../components/Ambient.astro';
import { getCollection } from 'astro:content';
import {
  SITE, SECTIONS, STEPS, url, readingTime, labelOf, wa, pathOf,
  RESULTS_LIVE, RESULTS, RESULT_NOTES,
} from '../lib/site';

const live = (arr: any[]) =>
  arr.filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const everything: any[] = [];
for (const s of SECTIONS) {
  for (const e of live(await getCollection(s.id as any))) everything.push(e);
}
everything.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = everything.slice(0, 3);

const resultsLive = RESULTS_LIVE && RESULTS.length > 0;

/* Los marcadores numerados cuentan desde una sola fuente: si un bloque se apaga con
   una bandera, la numeración no se queda con un hueco. */
let markN = 0;
const mark = () => ++markN;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.author,
  url: new URL(url('/'), Astro.site).href,
  description: SITE.description,
  sameAs: [SITE.instagram, SITE.beacons].filter(Boolean),
};
---
<Base title={SITE.name} description={SITE.description} schema={schema}>

  {/* 01 · Hero */}
  <div class="slab band-fx">
    <img class="herobg" src={url('/img/hero-spectrum.webp')} alt="" width="1920" height="1080"
         fetchpriority="high" decoding="async" />
    <span class="stars" aria-hidden="true"></span>
    <span class="herobg-scrim" aria-hidden="true"></span>
    <div class="wrap">
      <section class="hero">
        <h1 class="display face rise brandline">109MUSIC.CO</h1>
        <p class="statement rise">
          Your number one source to market your music. <b>Read how it works</b>,
          free, or <b>hand us the campaign</b> and we run it for you.
        </p>
        <div class="hero-cta rise">
          <a class="btn" href={wa('hero-call')} target="_blank" rel="noopener">
            <span>Book a call</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn ghost" href={url('/music-marketing/')}>
            <span>Read the articles</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </div>
  </div>

  <div class="wrap">

    {/* 02 · Real results. La tarjeta es la de Aura porque resuelve el problema que
        tenemos: una cifra grande por tarjeta y una línea de contexto que lleva la
        base de partida. Un "+400%" sobre doce streams diarios no es un resultado.
        En carrusel horizontal, con desvanecidos en los bordes para que las tarjetas
        se disuelvan en el fondo en vez de quedar cortadas. */}
    {resultsLive && (
      <section class="surf-bone">
        <Ambient />
        <SectionMarker n={mark()} slug="real_results" />
        <div class="sec-head">
          <h2 class="display">Real artists. Real numbers.</h2>
          <a href={url('/results/')}>All results →</a>
        </div>
        <p class="sec-intro">
          Every figure measured against the week before the campaign started.
        </p>
        {/* Sin esta linea el bloque se contradice con la comparativa, que promete
            que publicamos el metodo: tres cifras anonimas leidas justo despues de
            esa promesa la debilitan. Dicha en voz alta, el anonimato deja de ser
            una carencia y pasa a ser la prueba de que pedimos permiso antes. */}
        <p class="results-note mono">
          Names withheld until each artist signs off. Every figure comes from a
          dated platform screenshot.
        </p>
        <div class="rcarousel">
          {/* tabindex hace que el scroller reciba foco y las flechas del teclado
              funcionen sin una sola linea de JavaScript. */}
          <div class="rcarousel-track" tabindex="0" role="group"
               aria-label="Client results, scroll horizontally">
            {RESULTS.map((r) => <ResultCard data={r} />)}
            {/* Las notas van SIEMPRE detras de los resultados reales, nunca
                intercaladas: en escritorio las tres primeras tarjetas visibles
                tienen que ser las tres cifras, que es el argumento del bloque. */}
            {RESULT_NOTES.map((nte) => <ResultNote data={nte} />)}
          </div>
        </div>
      </section>
    )}

    {/* 03 · What we offer. Tarjeta = icono, título, UNA línea, botón. Nada de
        párrafos: este bloque orienta, no convence. Convencer es trabajo de la
        página de destino. La ruta gratis va primera y al mismo peso que las de
        pago, que es el argumento entero de la casa. */}
    <section class="surf-bone">
      <Ambient />
      <SectionMarker n={mark()} slug="what_we_offer" />
      <div class="sec-head"><h2 class="display">What we offer</h2></div>

      <div class="offergrid">
        <div class="offer">
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M5 6h9a4 4 0 0 1 4 4v16a3 3 0 0 0-3-3H5z"/>
              <path d="M27 6h-9a4 4 0 0 0-4 4v16a3 3 0 0 1 3-3h10z"/>
            </svg>
          </span>
          <p class="offer-tag mono">Free</p>
          <h3 class="display">Articles &amp; case studies</h3>
          <p>Music marketing strategies, platform news and real rollouts taken apart.</p>
          <a class="offer-cta mono" href={url('/music-marketing/')}>Start reading →</a>
        </div>

        <div class="offer offer--lead">
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="5.5"/>
              <path d="M16 2v5M16 25v5M2 16h5M25 16h5"/>
            </svg>
          </span>
          <p class="offer-tag mono">We run it</p>
          <h3 class="display">Meta ads &amp; playlisting</h3>
          <p>A person builds, watches and adjusts your campaign. You keep the pixel.</p>
          <a class="offer-cta mono" href={url('/services/')}>See how we work →</a>
        </div>

        <div class="offer">
          <span class="offer-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="24" height="22"/><path d="M4 12h24M12 12v15"/>
            </svg>
          </span>
          <p class="offer-tag mono">Tools</p>
          <h3 class="display">Templates &amp; submission</h3>
          <p>The sheets we use internally, and one track in front of real curators.</p>
          <a class="offer-cta mono" href={url('/resources/')}>Browse the resources →</a>
        </div>
      </div>
    </section>
  </div>

  {/* 04 · How we work. Sobre negro: es el bloque que vende y el negro es el
      mecanismo de énfasis del sistema, así que la jerarquía no cuesta ni un punto
      de tamaño de fuente. Cuatro pasos numerados en filas, no en carrusel: un
      proceso se lee de arriba abajo y un carrusel esconde la mitad. */}
  <div class="slab band-fx">
    <span class="stars" aria-hidden="true"></span>
    <div class="wrap">
      <section class="howwork">
        <SectionMarker n={mark()} slug="our_process" />
        <h2 class="display howwork-title">Our<br />process</h2>
        {/* LA LINEA DE CONTEXTO. El proceso es generico a proposito, porque su
            gracia es que el artista no elige de antemano, pero eso significa que
            los tres primeros pasos son tramite y la mecanica no aparece hasta el
            cuarto. Sin esta frase alguien puede leer el bloque entero sin saber
            que lo que vendemos son anuncios. Hace tres cosas a la vez: nombra el
            producto principal, coloca el playlisting como segundo, y mantiene el
            mensaje de que no hay que elegir de antemano. */}
        <p class="howwork-lead">
          <b>We run Meta ads and playlisting for independent artists.</b> Ads put
          your track in front of the exact listeners who should hear it.
          Playlisting puts it where people find music they were not looking for.
          You do not have to know which one you need.
        </p>

        {/* MOCKUP SOLO EN 04 Y 05. Los tres primeros pasos son una llamada, un PDF
            de precios y una factura: no tienen nada que enseñar, y cualquier imagen
            ahi seria relleno inventado. Con cinco mockups el bloque ademas sumaba
            unos 1.000px a una pagina que ya es larga. Tres filas ligeras y luego
            dos con peso da mejor ritmo, y pone el peso visual justo donde esta el
            argumento. Los mockups son NUESTROS y estan generados; cuando lleguen
            las capturas reales se sustituyen y no se toca el layout. */}
        <ol class="steps">
          {STEPS.map((s, i) => (
            <li class={s.shot ? 'step step--shot' : 'step'}>
              <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-body">
                <h3 class="display">{s.h}</h3>
                <p>{s.p}</p>
              </div>
              {s.shot && (
                <span class="step-shot">
                  <img src={url(s.shot)} alt="" loading="lazy" decoding="async"
                       width="440" height="640" />
                </span>
              )}
            </li>
          ))}
        </ol>

        {/* Los tres servicios de alrededor se fueron a /services/ el 14/08. El
            proceso termina y la peticion llega inmediatamente, sin una estanteria
            en medio, que es mejor bloque. */}
        <div class="steps-cta">
          <a class="btn" href={wa('how-we-work')} target="_blank" rel="noopener">
            <span>Book a call</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          <p class="mono">We tell you if we can move it before you spend anything.</p>
        </div>
      </section>
    </div>
  </div>

  <div class="wrap">

    {/* 05 · Learn it free. "Latest" sonaba a blog y escondía lo único que hace
        distinta a esta casa: que el método está publicado y no cuesta nada. El
        título paga la promesa que hace el hero, literalmente con las mismas
        palabras. Tres artículos, tope. */}
    {/* Sin <Ambient /> aqui: el lavado lila que sobraba en este bloque no era solo
        el tinte, era tambien el blob ambiental. Un listado de lectura no necesita
        atmosfera; la necesitan los bloques que venden. */}
    {latest.length > 0 && (
      <section class="surf-bone">
        <SectionMarker n={mark()} slug="the_109_blog" />
        <div class="sec-head">
          <h2 class="display">The 109 blog</h2>
          <a href={url('/rss.xml')}>Subscribe via RSS →</a>
        </div>
        <p class="sec-intro">
          Latest news, articles and case studies. Everything we run for clients,
          written down. No signup, no gate.
        </p>
        {/* Enlaces reales a cada sección, no filtros. Cero JavaScript y reparten
            autoridad hacia las tres secciones. */}
        <nav class="pills" aria-label="Browse by section">
          <a class="pill-link mono" href={url('/news/')}>News</a>
          <a class="pill-link mono" href={url('/music-marketing/')}>Music Marketing</a>
          <a class="pill-link mono" href={url('/business/')}>The Money Side</a>
        </nav>
        <ul class="rows">
          {latest.map((e) => (
            <Row
              href={pathOf(e.collection, e.id)}
              title={e.data.title}
              dek={e.data.dek}
              date={e.data.date}
              label={labelOf(e.collection)}
              minutes={readingTime(e.body)}
              hero={e.data.hero}
              showLabel={true}
            />
          ))}
        </ul>
      </section>
    )}

    {/* 06 · Lo que ya has probado. Va al final a propósito: es manejo de
        objeciones, y las objeciones se tratan justo antes de pedir la acción, no
        al entrar. Cuatro filas, no cinco. La última es la única que nuestra
        competencia no puede escribir. */}
    <section class="surf-bone">
      <SectionMarker n={mark()} slug="the_alternatives" />
      <div class="sec-head"><h2 class="display">What most artists try first</h2></div>
      <div class="cmp-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th class="cmp-lab"><span class="visually-hidden">Comparison</span></th>
              <th>Paid playlist placements</th>
              <th>Agency retainer</th>
              <th>Running ads yourself</th>
              <th class="cmp-us">109MUSIC</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th class="cmp-lab" scope="row">What you get</th>
              <td data-label="Paid playlist placements">Streams from accounts that never come back</td>
              <td data-label="Agency retainer">A deck, monthly</td>
              <td data-label="Running ads yourself">Reach, if the targeting is right</td>
              <td data-label="109MUSIC" class="cmp-us">Listeners who save and follow</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">What it costs</th>
              <td data-label="Paid playlist placements">Per placement, with no floor</td>
              <td data-label="Agency retainer">Monthly retainer, three-month minimum</td>
              <td data-label="Running ads yourself">Ad spend plus your own week</td>
              <td data-label="109MUSIC" class="cmp-us">Ad spend plus one flat fee</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">Who keeps the pixel</th>
              <td data-label="Paid playlist placements">Not applicable</td>
              <td data-label="Agency retainer">Usually the agency</td>
              <td data-label="Running ads yourself">You</td>
              <td data-label="109MUSIC" class="cmp-us">You, always</td>
            </tr>
            <tr>
              <th class="cmp-lab" scope="row">Can you check the method</th>
              <td data-label="Paid playlist placements">No</td>
              <td data-label="Agency retainer">No</td>
              <td data-label="Running ads yourself">Only your own</td>
              <td data-label="109MUSIC" class="cmp-us">Yes. We publish it before you pay</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="cmp-foot mono">
        The last row is the whole argument. Every article in
        <a href={url('/music-marketing/')}>the 109 blog</a> is what we run for clients,
        written down.
      </p>
    </section>
  </div>

  {/* 07 · Cierre */}
  <div class="slab band-fx">
    <span class="stars" aria-hidden="true"></span>
    <div class="wrap">
      <section class="workband">
        <p class="mono">Bespoke work</p>
        <h2 class="display face">Tell us what you are putting out.</h2>
        <p class="workband-line">
          We will tell you straight whether we can move it, and what it would cost.
          If the honest answer is that you should run it yourself, we will say that too.
        </p>
        {/* `hero-cta` es un contenedor flex SIN justify-content, o sea que alinea
            a la izquierda. En el hero eso es correcto porque el hero esta alineado
            a la izquierda. Aqui la banda es text-align:center, y text-align no
            afecta a los hijos de un flex: los botones se quedaban 279px a la
            izquierda del centro mientras el texto centraba. Medido, no percibido.
            El modificador centra sin tocar el hero. */}
        <div class="hero-cta hero-cta--center">
          <a class="btn" href={wa('close-call')} target="_blank" rel="noopener">
            <span>Book a call</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn ghost" href={url('/submit-your-track/')}>
            <span>Submit a track · 5 EUR</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="workband-fine mono">Replies from a person, usually same day</p>
      </section>
    </div>
  </div>
</Base>
