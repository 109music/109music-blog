---
/* Music Business is a NAVIGATION section that reads across the editorial collections.
   It owns no articles of its own: every piece keeps the URL of the collection it was
   published in, so nothing moves and no link ever breaks. */
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import { getCollection } from 'astro:content';
import { readingTime, url, orderTags, tagLabel, sectionOf, labelOf } from '../../lib/site';

const s = sectionOf('music-business')!;

const COLLECTIONS = ['news', 'music-marketing', 'case-studies'] as const;
const all = (
  await Promise.all(
    COLLECTIONS.map(async (c) =>
      (await getCollection(c)).map((e: any) => ({ entry: e, collection: c })),
    ),
  )
).flat();

const tagged = all
  .filter(({ entry }) => !entry.data.draft && entry.data.tags.includes('music-business'))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());

/* Two blocks, derived — no extra frontmatter, no second home for any article.
   Evergreen = the pieces that explain how the business works and do not expire.
   Business news = the same subject arriving as a dated event, which News also carries. */
const evergreen = tagged.filter(({ collection }) => collection !== 'news');
const businessNews = tagged.filter(({ collection }) => collection === 'news');
const sorted = tagged;

const present = orderTags([...new Set(sorted.flatMap(({ entry }) => entry.data.tags))]);
---
<Base title={s.label} description={`${s.blurb} Music business coverage from 109MUSIC.`} activeSection={s.id}>
  <div class="lightband">
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · {s.label}</p>
      <h1 class="display rise">Music<br /><span class="lav">business</span></h1>
      <p class="sub rise">{s.blurb}</p>
      {present.length > 0 && (
        <nav class="chips" aria-label="Topics in Music Business" style="margin-top:28px">
          {present.map((t) => <a class="chip" href={url(`/tags/${t}/`)}>{tagLabel(t)}</a>)}
        </nav>
      )}
    </section>
   </div>
  </div>

  <div class="wrap">
    <section>
      <div class="sec-head">
        <h2 class="display">How it works</h2>
      </div>
      <p class="sec-intro">
        The pieces that explain the machinery. These do not expire.
      </p>
      {evergreen.length ? (
        <ul class="rows">
          {evergreen.map(({ entry, collection }, i) => (
            <Row n={i + 1} href={`/${collection}/${entry.id}/`} title={entry.data.title}
                 dek={entry.data.dek} date={entry.data.date} label={labelOf(collection)}
                 minutes={readingTime(entry.body)} hero={entry.data.hero} />
          ))}
        </ul>
      ) : (<p class="empty">Nothing filed here yet.</p>)}
    </section>

    <section>
      <div class="sec-head">
        <h2 class="display">Business news</h2>
        <a href={url('/news/')}>All news →</a>
      </div>
      <p class="sec-intro">
        The same subject as it happens. These also appear in News, in date order.
      </p>
      {businessNews.length ? (
        <ul class="rows">
          {businessNews.map(({ entry, collection }, i) => (
            <Row n={i + 1} href={`/${collection}/${entry.id}/`} title={entry.data.title}
                 dek={entry.data.dek} date={entry.data.date} label={labelOf(collection)}
                 minutes={readingTime(entry.body)} hero={entry.data.hero} />
          ))}
        </ul>
      ) : (<p class="empty">No business news yet.</p>)}
    </section>
  </div>
</Base>
