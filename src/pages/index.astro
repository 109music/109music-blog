---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import { getCollection } from 'astro:content';
import { SITE, SECTIONS, TAGS, url, readingTime, labelOf } from '../lib/site';

const live = (arr: any[]) =>
  arr.filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const buckets: { id: string; label: string; entries: any[] }[] = [];
const everything: any[] = [];
for (const s of SECTIONS) {
  const entries = live(await getCollection(s.id as any));
  everything.push(...entries);
  buckets.push({ id: s.id, label: s.label, entries: entries.slice(0, 4) });
}

const latest = [...everything].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const tagCounts = new Map<string, number>();
for (const e of everything) for (const t of e.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const topTags = TAGS.filter((t) => (tagCounts.get(t.slug) ?? 0) > 0);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      url: new URL(url('/'), Astro.site).href,
      description: SITE.description,
      sameAs: [SITE.instagram, SITE.beacons],
    },
    {
      '@type': 'WebSite',
      name: SITE.name,
      url: new URL(url('/'), Astro.site).href,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@type': 'Organization', name: SITE.name },
    },
  ],
};
---
<Base title={SITE.name} description={SITE.description} schema={schema}>
  <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">Independent music marketing · Published weekly</p>
      <h1 class="display rise">MUSIC<br />MARKETING,<br /><span class="lav">BROKEN DOWN.</span></h1>
      <p class="sub rise">
        Release strategy, platform news and real rollout teardowns for independent artists.
        Every number sourced. Every playbook runnable without a label budget.
      </p>
    </section>

    {latest && (
      <>
        <div class="sec-head">
          <h2 class="display">Latest</h2>
          <a href={url('/rss.xml')}>Subscribe via RSS</a>
        </div>
        <ul class="rows">
          <Row
            n={1}
            href={`/${latest.collection}/${latest.id}/`}
            title={latest.data.title}
            dek={latest.data.dek}
            date={latest.data.date}
            label={labelOf(latest.collection)}
            minutes={readingTime(latest.body)}
            hero={latest.data.hero}
          />
        </ul>
      </>
    )}

    {buckets.map((b) => (
      <>
        <div class="sec-head">
          <h2 class="display">{b.label}</h2>
          <a href={url(`/${b.id}/`)}>All {b.label} →</a>
        </div>
        {b.entries.length ? (
          <ul class="rows">
            {b.entries.map((e, i) => (
              <Row
                n={i + 1}
                href={`/${b.id}/${e.id}/`}
                title={e.data.title}
                dek={e.data.dek}
                date={e.data.date}
                label={b.label}
                minutes={readingTime(e.body)}
                hero={e.data.hero}
              />
            ))}
          </ul>
        ) : (
          <p class="empty">Nothing here yet.</p>
        )}
      </>
    ))}

    {topTags.length > 0 && (
      <>
        <div class="sec-head">
          <h2 class="display">Topics</h2>
          <a href={url('/tags/')}>All topics →</a>
        </div>
        <nav class="chips" aria-label="Topics" style="margin-top:22px">
          {topTags.map((t) => (
            <a class="chip" href={url(`/tags/${t.slug}/`)}>
              {t.label}<span class="n">{tagCounts.get(t.slug)}</span>
            </a>
          ))}
        </nav>
      </>
    )}
  </div>
</Base>
