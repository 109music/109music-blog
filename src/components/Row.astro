---
import { url, fmtDate, pad } from '../lib/site';

/* The index row. `.plate` is a reserved hero slot: it renders a numbered branded
   plate today and an <img> in Stage 2 at identical geometry, so adding photos
   changes no layout on any breakpoint. */
interface Props {
  n: number;
  href: string;
  title: string;
  dek?: string;
  date: Date;
  label: string;
  minutes?: number;
  showDek?: boolean;
  hero?: { src: string; alt: string; treatment?: string } | null;
}
const {
  n, href, title, dek = '', date, label, minutes, showDek = true, hero = null,
} = Astro.props;
const gray = hero?.treatment !== 'colour';
---
<li class="row">
  <a href={url(href)}>
    <span class={`plate${hero ? ' has-img' : ''}`}>
      {hero ? (
        <img src={url(hero.src)} alt={hero.alt} loading="lazy" decoding="async" class={gray ? 'grayscale' : ''} />
      ) : (
        <span class="plate-n" aria-hidden="true">{pad(n)}</span>
      )}
    </span>

    <span class="rowmain">
      <span class="ttl">{title}</span>
      {showDek && dek && <p class="dek">{dek}</p>}
    </span>

    <span class="meta">
      <span>{label}</span>
      <span>{fmtDate(date)}</span>
      {minutes && <span>{minutes} MIN</span>}
    </span>
  </a>
</li>
