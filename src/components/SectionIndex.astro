---
import Base from '../layouts/Base.astro';
import Row from './Row.astro';
import { readingTime, url, orderTags, tagLabel } from '../lib/site';

interface Props { id: string; label: string; blurb: string; entries: any[]; }
const { id, label, blurb, entries } = Astro.props;
const sorted = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Topic shortcuts for this section only. Sections navigate, tags browse. */
const present = orderTags([...new Set(sorted.flatMap((e) => e.data.tags))]);

const words = label.split(' ');
---
<Base title={label} description={`${blurb} ${label} from 109MUSIC.`} activeSection={id}>
  <div class="slab slab--tight">
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · {label}</p>
      <h1 class="display rise">
        {words[0]}{words[1] && <><br /><span class="lav">{words[1]}</span></>}
      </h1>
      <p class="sub rise">{blurb}</p>
      {present.length > 0 && (
        <nav class="chips" aria-label={`Topics in ${label}`} style="margin-top:28px">
          {present.map((t) => <a class="chip" href={url(`/tags/${t}/`)}>{tagLabel(t)}</a>)}
        </nav>
      )}
    </section>
   </div>
  </div>

  <div class="wrap">
    {sorted.length ? (
      <ul class="rows">
        {sorted.map((e, i) => (
          <Row
            n={i + 1}
            href={`/${id}/${e.id}/`}
            title={e.data.title}
            dek={e.data.dek}
            date={e.data.date}
            label={label}
            minutes={readingTime(e.body)}
            hero={e.data.hero}
          />
        ))}
      </ul>
    ) : (
      <p class="empty">Nothing published in this section yet.</p>
    )}
  </div>
</Base>
