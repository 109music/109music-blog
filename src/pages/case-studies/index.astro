---
import SectionIndex from '../../components/SectionIndex.astro';
import { getCollection } from 'astro:content';
import { sectionOf } from '../../lib/site';

const s = sectionOf('case-studies')!;
const entries = await getCollection('case-studies');
---
<SectionIndex id={s.id} label={s.label} blurb={s.blurb} entries={entries} />
