---
import { url, orderTags, tagLabel } from '../lib/site';

interface Props { tags?: string[]; label?: string; }
const { tags = [], label = 'Topics' } = Astro.props;
const ordered = orderTags(tags);
---
{ordered.length > 0 && (
  <nav class="chips" aria-label={label}>
    {ordered.map((t) => (
      <a class="chip" href={url(`/tags/${t}/`)}>{tagLabel(t)}</a>
    ))}
  </nav>
)}
