---
/* The one section-page shell. Every editorial section renders through this so the
   surface rhythm cannot drift page by page — which is exactly what had happened:
   News was dark, Case Studies was light, Music Marketing and Business had hand-rolled
   pages, and the four felt like four different sites.

   The rhythm, identical to the home page:
     dark hero  ->  bone list  ->  tint block  ->  dark CTA
   Never two identical surfaces in a row. Transitions are signalled ONLY by the change
   of surface plus the numbered mono marker — no rules, no gradients between bands. */
import Base from '../layouts/Base.astro';
import Row from './Row.astro';
import SectionMarker from './SectionMarker.astro';
import { readingTime, url, orderTags, tagLabel, wa, pathOf } from '../lib/site';

interface Props {
  id: string;
  label: string;
  blurb: string;
  entries: any[];
  /** Optional second shelf, rendered on tint under its own heading. */
  extra?: { heading: string; intro?: string; items: any[] } | null;
  /** Extra nav rendered inside the hero (moment jumper, cross-link, etc.) */
  crossLink?: { href: string; label: string } | null;
  listHeading?: string;
  listIntro?: string;
}
const {
  id, label, blurb, entries, extra = null, crossLink = null,
  listHeading = 'Everything filed here', listIntro = '',
} = Astro.props;

const sorted = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Topic shortcuts for this section only. Sections navigate, tags browse. */
const present = orderTags([...new Set(sorted.flatMap((e) => e.data.tags))]);
const words = label.split(' ');
---
<Base title={label} description={`${blurb} ${label} from 109MUSIC.`} activeSection={id}>

  <!-- 01 · hero, always dark, identical geometry on every section -->
  <div class="slab slab--tight">
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · {label}</p>
      <h1 class="display face rise">
        {words[0]}{words.slice(1).length > 0 && <><br /><span class="lav">{words.slice(1).join(' ')}</span></>}
      </h1>
      <p class="sub rise">{blurb}</p>
      {crossLink && (
        <p class="crosslink rise">
          <a href={url(crossLink.href)}>{crossLink.label} <span aria-hidden="true">→</span></a>
        </p>
      )}
      <slot name="hero-extra" />
      {present.length > 0 && (
        <nav class="chips" aria-label={`Topics in ${label}`} style="margin-top:28px">
          {present.map((t) => <a class="chip" href={url(`/tags/${t}/`)}>{tagLabel(t)}</a>)}
        </nav>
      )}
    </section>
   </div>
  </div>

  <div class="wrap">
    <!-- 02 · the list, on bone -->
    <section class="surf-bone">
      <SectionMarker n={1} slug={id.replace(/-/g, '_')} />
      <div class="sec-head"><h2 class="display">{listHeading}</h2></div>
      {listIntro && <p class="sec-intro">{listIntro}</p>}
      {sorted.length ? (
        <ul class="rows">
          {sorted.map((e, i) => (
            /* href/label may be pre-built by the caller. A virtual section reads across
               several collections, so its rows cannot be addressed by this section's own
               path — each entry keeps the URL of the collection it was published in. */
            <Row
              n={i + 1}
              href={e.href ?? pathOf(id, e.id)}
              title={e.data.title}
              dek={e.data.dek}
              date={e.data.date}
              label={e.label ?? label}
              minutes={readingTime(e.body)}
              hero={e.data.hero}
            />
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing published in this section yet.</p>
      )}
    </section>

    <!-- 03 · optional second shelf, on tint -->
    {extra && (
      <section class="surf-tint">
        <SectionMarker n={2} slug={extra.heading.toLowerCase().replace(/[^a-z]+/g, '_')} />
        <div class="sec-head"><h2 class="display">{extra.heading}</h2></div>
        {extra.intro && <p class="sec-intro">{extra.intro}</p>}
        {extra.items.length ? (
          <ul class="rows">
            {extra.items.map((e: any, i: number) => (
              <Row n={i + 1} href={e.href} title={e.data.title} dek={e.data.dek}
                   date={e.data.date} label={e.label} minutes={readingTime(e.body ?? '')}
                   hero={e.data.hero} />
            ))}
          </ul>
        ) : (<p class="empty">Nothing filed here yet.</p>)}
      </section>
    )}
  </div>

  <!-- 04 · the same commercial close as the home page. Tight padding: a section
       page is short, and the full 148px band pushed these pages past 50% dark. -->
  <div class="slab slab--tight">
    <div class="wrap">
      <section class="workband">
        <p class="mono">Bespoke work</p>
        <h2 class="display face">We run this for artists, not just write about it.</h2>
        <p class="workband-line">
          Meta ads, release planning and playlisting for independent artists. Tell us what
          you are putting out and we will tell you straight whether we can move it.
        </p>
        <a class="btn" href={wa('article')} target="_blank" rel="noopener">
          <span>Message us on WhatsApp</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="workband-fine mono">Replies from a person, usually same day</p>
      </section>
    </div>
  </div>
</Base>
