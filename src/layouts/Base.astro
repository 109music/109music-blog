---
import '../styles/global.css';
import { SITE, NAV_VISIBLE, NAV_PARENT, NAV_CTA, FOOT_NAV, url } from '../lib/site';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description: string;
  paper?: boolean;
  ogType?: string;
  schema?: object | null;
  activeSection?: string;
  noindex?: boolean;
  /* Absolute-from-root path to the share card, e.g. /img/og/news/slug.jpg.
     Left empty every page falls back to the site card. */
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description,
  paper = true,
  ogType = 'website',
  schema = null,
  activeSection = '',
  noindex = false,
  image = '/img/og/default.jpg',
  imageAlt = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;

/* The share card is ALWAYS one of ours, never a sourced photograph. A Facebook or
   WhatsApp preview cannot carry a credit line, so putting a Creative Commons photo
   there would be redistributing it without attribution — the one thing the licence
   actually asks for. A generated brand card sidesteps the question completely and
   has the side benefit that everything shared looks like the same publication.
   JPG rather than WebP: some scrapers still refuse WebP and fall back to nothing. */
const ogImage = new URL(url(image), Astro.site).href;
---
<!doctype html>
<html lang={SITE.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={SITE.author} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
  <meta name="theme-color" content={paper ? '#F4F3EF' : '#0A0A0A'} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — all articles`} href={url('/rss.xml')} />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={url('/fonts/archivo-black-latin-400-normal.woff2')} />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={url('/fonts/inter-latin-500-normal.woff2')} />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={url('/fonts/archivo-latin-wght-normal.woff2')} />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <slot name="head" />
<!-- Motion: el unico JS del sistema. El porque, en PASE 17 de global.css. -->
<script is:inline>
(function(){var r=document.documentElement;
if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
r.className+=' rvl';
addEventListener('DOMContentLoaded',function(){
var io=new IntersectionObserver(function(es){for(var i=0;i<es.length;i++)if(es[i].isIntersecting){es[i].target.classList.add('is-in');io.unobserve(es[i].target)}},{rootMargin:'0px 0px -8% 0px'});
var e=document.querySelectorAll('[data-rvl]');for(var i=0;i<e.length;i++)io.observe(e[i]);});})();
</script>
</head>
<body class={paper ? 'paper' : ''}>
  {/* Enlace de salto. Sin el, quien navega con teclado se come SIETE tabuladores
      de cabecera en cada pagina antes de llegar al contenido. Solo se ve cuando
      recibe foco. */}
  <a class="skiplink" href="#content">Skip to content</a>
  <Search />
  <slot name="progress" />

  <div class="slab sitehead">
   <div class="wrap">
    <header class="chrome">
      {/* El wordmark es la marca, no el handle. La arroba pertenece a Instagram y
          en la web no significa nada: aquí ya estás EN 109music.co. La única arroba
          correcta del sitio es la del pie, que enlaza literalmente a la cuenta. */}
      <a class="wordmark" href={url('/')}>109MUSIC.CO</a>
      {/* MENU MOVIL. Iba con <details> y ROMPIO LA CABECERA EN ESCRITORIO.
          Motivo: un <details> cerrado oculta todo lo que no sea el <summary>, y
          desde Chrome 131 lo hace con `content-visibility: hidden` sobre el
          pseudoelemento ::details-content. Un `display: flex` sobre el hijo NO
          gana a eso. En el Chromium con el que verifico si ganaba, asi que el
          fallo no se reproducia aqui y lo di por bueno: la barra se veia en mi
          medicion y desaparecia en el navegador de Blanca.

          Ahora es un <button> con aria-expanded y 180 bytes de JS. He defendido
          el presupuesto de JavaScript de esta home en cada decision, y aqui toca
          gastarlo: una cabecera que depende de la version del navegador no es una
          cabecera. El boton ademas degrada solo, porque `.nav` es visible por
          defecto y el script unicamente la colapsa cuando puede ejecutarse. */}
      <div class="navwrap" data-navwrap>
        <button class="navtoggle" type="button" aria-expanded="false" aria-controls="sitenav" aria-label="Menu" data-navtoggle>
          <span class="navtoggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="navtoggle-word mono">Menu</span>
        </button>
      <nav class="nav" id="sitenav" aria-label="Sections">
        {NAV_VISIBLE.map((n: any) =>
          n.children ? (
            /* Grouped, not hidden. Every child is a real anchor in the DOM on every
               page, so the group costs nothing in crawlability. The panel opens on
               hover AND on focus-within, so it works from the keyboard with no JS.
               Below 900px the panel is displayed inline and the group flattens. */
            <div class="navgroup" data-nav-group>
              <button
                type="button"
                class="navgroup-btn"
                aria-expanded="false"
                aria-controls="nav-blog"
                aria-current={NAV_PARENT[activeSection] === n.id ? 'true' : undefined}
              >{n.label} <span class="caret" aria-hidden="true">▾</span></button>
              <div class="navpanel" id="nav-blog">
                <p class="navpanel-head mono">Everything we publish</p>
                {n.children.map((c: any) => (
                  <a href={url(c.href)} aria-current={activeSection === c.id ? 'page' : undefined}>
                    <span class="np-label">{c.label}</span>
                    <span class="np-blurb">{c.blurb}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={url(n.href)} aria-current={activeSection === n.id ? 'page' : undefined}>{n.label}</a>
          ),
        )}
        <button class="searchbtn" type="button" data-search-open aria-label="Search" aria-haspopup="dialog">
          <svg viewBox="0 0 20 20" aria-hidden="true" width="15" height="15">
            <circle cx="9" cy="9" r="6.2" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M13.6 13.6 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <a class="navcta" href={url(NAV_CTA.href)}>{NAV_CTA.label} <span aria-hidden="true">→</span></a>
      </nav>
      </div>
    </header>
   </div>
  </div>

  <script is:inline>
    /* 180 bytes. Colapsa el panel solo si el script corre: sin el, `.nav` se ve,
       que es el fallo seguro correcto. `[data-open]` sustituye a `[open]`. */
    (function () {
      var w = document.querySelector('[data-navwrap]'), b = w && w.querySelector('[data-navtoggle]');
      if (!w || !b) return;
      w.setAttribute('data-js', '');
      b.addEventListener('click', function () {
        var o = w.hasAttribute('data-open');
        o ? w.removeAttribute('data-open') : w.setAttribute('data-open', '');
        b.setAttribute('aria-expanded', String(!o));
      });
    })();
  </script>

  {/* <main> no existia en el sitio. Es la referencia semantica mas basica que hay
      y sin ella un lector de pantalla no tiene forma de saltar a lo importante. */}
  <main id="content">
    <slot />
  </main>

  <div class="slab slab--tight sitefoot">
   <div class="wrap">
    <footer class="foot">
      <span class="mono">© {new Date().getFullYear()} 109MUSIC</span>
      <span class="mono">
        {FOOT_NAV.map((f) => (<><a href={url(f.href)}>{f.label}</a> · </>))}<a href={SITE.instagram} target="_blank" rel="noopener">@109music.co</a> · <a href={SITE.beacons} target="_blank" rel="noopener">Beacons</a>
      </span>
    </footer>
   </div>
  </div>
</body>
</html>
