---
import Base from './Base.astro';
import IGEmbed from '../components/IGEmbed.astro';
import TagChips from '../components/TagChips.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { SITE, url, fmtDate, isoDate, readingTime, tagLabel } from '../lib/site';

interface Props {
  entry: any;
  sectionId: string;
  sectionLabel: string;
}
const { entry, sectionId, sectionLabel } = Astro.props;
const d = entry.data;
const minutes = readingTime(entry.body);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* No filter on the web. `hero.treatment` is still accepted by the schema so the
   nine pre-existing articles validate, and is deliberately not read: an untouched
   photo is not a derivative work, which is what keeps the licence chain simple.
   Grayscale survives only in the Instagram carousels. */

/* The share card is always ours. Convention over configuration: the generator
   writes /img/og/<section>/<slug>.jpg for every article, and `og` in frontmatter
   only exists to override a card that came out wrong. */
const slug = entry.id.replace(/\.md$/, '').split('/').pop();
/* Solo va de fondo si hay hero Y su layout lo permite. Un hero tipografico
   nunca: ya lleva su propio titular dentro. */
const bgHero = !!d.hero && d.hero.layout !== 'below';
const trailingEmbeds = (d.igEmbeds ?? []).filter((e: any) => !e.after);
/* Una FOTO no se comporta como un grafico generado. Los nuestros son oscuros
   por construccion; una foto de directo lleva cara, piel y ropa clara justo en
   la banda donde cae el titular. Medido: con el velo normal los seis titulares
   y deks de los tres articulos con foto bajaban del minimo AA. El velo fuerte
   se activa por procedencia, no a mano, para que no se olvide en la siguiente. */
const photoHero = bgHero && !!d.hero.source && d.hero.source !== 'own';
const ogImage = d.og ?? `/img/og/${sectionId}/${slug}.jpg`;

const schema: any = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.dek,
  datePublished: isoDate(d.date),
  dateModified: isoDate(d.updated ?? d.date),
  inLanguage: 'en',
  articleSection: sectionLabel,
  keywords: d.tags.map((t: string) => tagLabel(t)).join(', '),
  wordCount: entry.body.trim().split(/\s+/).length,
  author: { '@type': 'Organization', name: SITE.author, url: SITE.instagram },
  publisher: { '@type': 'Organization', name: SITE.author, url: new URL(url('/'), Astro.site).href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  isAccessibleForFree: true,
};
if (d.sources?.length) {
  schema.citation = d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.name, url: s.url }));
}
if (d.hero) {
  schema.image = new URL(url(d.hero.src), Astro.site).href;
}

const graph: any[] = [schema];
if (d.faq?.length) {
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f: any) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base
  title={d.title}
  description={d.dek}
  paper={true}
  ogType="article"
  schema={graph.length === 1 ? graph[0] : graph}
  activeSection={sectionId}
  image={ogImage}
  imageAlt={d.title}
>
  <ReadingProgress slot="progress" />

  {/* El hero como FONDO del masthead. Ver el bloque HERO DE FONDO en el CSS
      para el velo y los numeros de contraste medidos sobre cada imagen. */}
  <div class={bgHero ? (photoHero ? 'masthead masthead--bg masthead--photo' : 'masthead masthead--bg') : 'masthead'}
       style={bgHero ? `background-image: var(--scrim), url('${url(d.hero.src)}')` : undefined}>
    <div class="wrap inner">
      <span class="pill">{sectionLabel}</span>
      <h1 class="display">{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <div class="facts mono">
        <span>Published <b>{fmtDate(d.date)}</b></span>
        {d.updated && <span>Updated <b>{fmtDate(d.updated)}</b></span>}
        <span><b>{minutes}</b> min read</span>
        <span>By <b>109MUSIC</b></span>
      </div>
      <TagChips tags={d.tags} label="Article topics" />
      {/* El credito va DENTRO del masthead cuando la imagen es el fondo: ya no
          existe un "debajo de la imagen" donde ponerlo. Abajo a la derecha, sobre
          la parte mas oscura del velo. Sin esto la cadena de licencias se rompe:
          una CC BY sin credito visible deja de estar acreditada. */}
      {bgHero && (d.hero.credit || d.hero.license) && (
        <p class="masthead-credit mono">
          {d.hero.creditUrl
            ? <a href={d.hero.creditUrl} target="_blank" rel="noopener nofollow">{d.hero.credit}</a>
            : d.hero.credit}
          {d.hero.credit && d.hero.license && ' · '}
          {d.hero.license}
        </p>
      )}
    </div>
  </div>

  {/* The hero. Nothing renders without `hero` in the frontmatter, and nothing is
      reserved either: the body simply rises against the masthead, which is how the
      nine articles written before any imagery existed still read correctly. An
      empty frame would be worse than no frame. */}
  {/* En movil el patron de fondo se apaga, asi que la imagen tiene que volver a
      aparecer debajo. Se emite siempre que hay hero de fondo y el CSS la oculta
      en escritorio. */}
  {bgHero && (
    <div class="wrap hero-mobile">
      <figure class="hero-frame">
        <img src={url(d.hero.src)} alt={d.hero.alt} width="1600" height="900" decoding="async" />
      </figure>
    </div>
  )}

  {d.hero && !bgHero && (
    <div class="wrap">
      <figure class="hero-frame">
        <img src={url(d.hero.src)} alt={d.hero.alt} width="1600" height="900"
             fetchpriority="high" decoding="async" />
      </figure>
      {(d.hero.credit || d.hero.license) && (
        <p class="hero-credit mono">
          {d.hero.creditUrl
            ? <a href={d.hero.creditUrl} target="_blank" rel="noopener nofollow">{d.hero.credit}</a>
            : d.hero.credit}
          {d.hero.credit && d.hero.license && ' · '}
          {d.hero.license}
        </p>
      )}
    </div>
  )}

  <main class="wrap article">
    <div class="body">
      <div class="prose">
        <slot />
      </div>

      {/* Los embeds SIN `after` van aqui, al final del cuerpo. Los que llevan
          `after` ya los ha colocado rehype-media bajo su h2. Y si el articulo
          no declara ninguno, se mantiene el campo de siempre, que ademas
          dibuja el hueco con su aviso cuando todavia no hay carrusel. */}
      {trailingEmbeds.length > 0
        ? trailingEmbeds.map((e: any) => (
            <IGEmbed permalink={e.url} caption={e.caption ?? `"${d.title}" as a carousel`} />
          ))
        : <IGEmbed permalink={d.igEmbed} caption={`"${d.title}" as a carousel`} />}

      {d.faq?.length > 0 && (
        <section class="faq">
          <h2>Common questions</h2>
          {d.faq.map((f: any) => (
            <div class="qa">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}

      {d.sources?.length > 0 && (
        <section class="sources">
          <h2 class="display">Sources</h2>
          <ol>
            {d.sources.map((s: any) => (
              <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>
            ))}
          </ol>
        </section>
      )}

      {d.cta && (
        <aside class="cta">
          {d.cta.keyword && <span class="pill">Comment {d.cta.keyword}</span>}
          <h2>{d.cta.heading}</h2>
          <p>{d.cta.line}</p>
          <a class="btn" href={d.cta.buttonUrl} target="_blank" rel="noopener">
            <span>{d.cta.buttonText}</span><span class="arrow" aria-hidden="true">→</span>
          </a>
          {d.cta.keyword && (
            <p class="fine">Comment {d.cta.keyword} on @109music.co and the link is sent to you</p>
          )}
        </aside>
      )}
    </div>
  </main>

  {/* Outside <main class="article"> on purpose: the .article rules restyle every h2 and a
      inside it, which would leak into this module. */}
  <div class="wrap">
    <RelatedArticles collection={entry.collection} id={entry.id} tags={d.tags} />
  </div>
</Base>
