---
import Base from '../../layouts/Base.astro';
import { SITE, SERVICES_AROUND, url, wa } from '../../lib/site';
const SERVICES = [
  {
    id: 'meta-ads',
    name: 'Meta ads for music',
    line: 'Reach you control. Campaigns built, targeted and optimised in-house, run mostly to Spotify and adjusted while they are live.',
    points: ['Release and tour campaigns', 'Geo-targeting down to the venue radius', 'The pixel sits on your ad account, not ours', 'Weekly reporting against a baseline we record first'],
    price: '450 EUR management · ad spend from 500 EUR, paid by you straight to the platform',
    waKey: 'meta-ads' as const,
    priced: false,
  },
  {
    id: 'playlisting',
    name: 'Playlisting',
    line: 'Discovery. Your track where people find music they were not looking for, pitched to real curators.',
    points: ['One track, pitched to 100% organic playlists', 'No bots, no bought placements', 'You get the list of who was pitched', 'Six tiers, from 100 to 1,300 EUR'],
    price: 'From 100 EUR · fixed price, no retainer',
    waKey: 'playlisting' as const,
    priced: true,
  },
];
---
<Base title="Services" description="Meta ads and playlisting for independent artists, run by 109MUSIC." activeSection="services">
  <div class="slab slab--tight">
   <div class="wrap">
    <section class="hero">
      <p class="kicker mono rise">109MUSIC · Services</p>
      <h1 class="display face rise">Our<br /><span class="lav">services</span></h1>
      <p class="sub rise">Everything we run, and what each one costs.</p>
    </section>
   </div>
  </div>

  <div class="wrap">
    {SERVICES.map((s) => (
      <section id={s.id}>
        <div class="sec-head"><h2 class="display">{s.name}</h2></div>
        <p class="sec-intro">{s.line}</p>
        <ul class="ticks">{s.points.map((p) => <li>{p}</li>)}</ul>
        <p class="svc-price mono">{s.price}</p>
        {s.priced ? (
          <a class="btn" href={url('/submit-your-track/')}>
            <span>Submit your track · 5 EUR</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <a class="btn" href={wa(s.waKey)} target="_blank" rel="noopener">
            <span>Ask about {s.name}</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
      </section>
    ))}

    {/* Segundo nivel. NO son cinco servicios al mismo peso: cinco iguales vuelven
        a poner al artista a elegir, que es justo lo que el proceso promete que no
        tiene que hacer. Dos productos arriba, y lo que va alrededor debajo. */}
    <section id="around">
      <div class="sec-head"><h2 class="display">And everything around them</h2></div>
      <p class="sec-intro">Added to a campaign, or bought on their own.</p>
      <ul class="aroundlist">
        {SERVICES_AROUND.map((a) => (
          <li>
            <span class="around-name">{a.label}</span>
            <span class="around-line">{a.line}</span>
            <span class="around-price mono">{a.price}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="slab">
    <div class="wrap">
      <section class="workband">
        <p class="mono">Not sure which</p>
        <h2 class="display">Tell us what you are putting out.</h2>
        <p class="workband-line">We will tell you straight whether we can move it, and what it would cost.</p>
        <a class="btn" href={wa('services')} target="_blank" rel="noopener">
          <span>Message us on WhatsApp</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="workband-fine mono">Replies from a person, usually same day</p>
      </section>
    </div>
  </div>
</Base>
