---
/* Retired 2026-08-14: /case-studies/<slug>/ -> /music-marketing/case-studies/<slug>/.
   Driven by LEGACY_CASE_STUDY_SLUGS, not by the live collection, so these stubs keep
   working even if an article is later renamed, re-filed or unpublished. */
import Redirect from '../../layouts/Redirect.astro';
import { LEGACY_CASE_STUDY_SLUGS, url } from '../../lib/site';

export function getStaticPaths() {
  return LEGACY_CASE_STUDY_SLUGS.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
---
<Redirect to={url(`/music-marketing/case-studies/${slug}/`)} label="Case Studies" />
