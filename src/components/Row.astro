---
import { url, fmtDate } from '../lib/site';

/* LA FILA DE LISTADO, rehecha 2026-08-15 sobre el patron de
   musicbusinessworldwide.com: imagen APAISADA a la IZQUIERDA, y a su derecha una
   sola columna de texto con una linea de metadatos encima del titular.

   Por que se movio la fecha. Antes la rejilla era `150px de fecha | texto | 72px
   de minutos`, y esa columna de fecha eran 150px casi vacios. Al meter la imagen
   a la izquierda habrian sido tres columnas apretadas. Con los metadatos en una
   linea de mono encima del titular, esos 150px pasan a la imagen sin ensanchar
   la fila, y las filas SIN imagen quedan mas limpias que antes, porque degradan
   a una sola columna de texto en vez de a una rejilla con un hueco.

   LA MINIATURA ES EL HERO, EN PEQUEÑO. No una imagen distinta: se genera
   reescalando el hero del propio articulo, que tambien es 16:9. Asi la fila del
   listado y la cabecera del articulo se reconocen como la misma pieza. Cuando
   lleguen las fotos reales, la miniatura sale de la foto, no del grafico. */
interface Props {
  n?: number;
  href: string;
  title: string;
  dek?: string;
  date: Date;
  label: string;
  minutes?: number;
  showDek?: boolean;
  hero?: { src: string; alt: string; thumb?: string; treatment?: string } | null;
  showLabel?: boolean;
}
const {
  href, title, dek = '', date, label, minutes, showDek = true, hero = null, showLabel = false,
} = Astro.props;

/* Sin filtro. El gris vive solo en los carruseles de Instagram. */
const thumb = hero ? (hero.thumb ?? hero.src) : null;
---
<li class="row" data-rvl>
  <a href={url(href)} class={thumb ? 'has-thumb' : undefined}>
    {thumb && (
      <span class="row-thumb">
        <img src={url(thumb)} alt="" loading="lazy" decoding="async" width="480" height="270" />
      </span>
    )}
    <span class="row-main">
      <span class="row-meta mono">
        <span class="d">{fmtDate(date)}</span>
        {showLabel && <><span class="sep" aria-hidden="true">·</span><span>{label}</span></>}
        {minutes && <><span class="sep" aria-hidden="true">·</span><span>{minutes} min</span></>}
      </span>
      <span class="ttl">{title}</span>
      {showDek && dek && <span class="dek">{dek}</span>}
    </span>
  </a>
</li>
