---
import { url, fmtDate, pad } from '../lib/site';
interface Props {
  n: number;
  href: string;
  title: string;
  dek?: string;
  date: Date;
  label: string;
  minutes?: number;
  showDek?: boolean;
}
const { n, href, title, dek = '', date, label, minutes, showDek = true } = Astro.props;
---
<li class="row">
  <a href={url(href)}>
    <span class="num">{pad(n)}</span>
    <span class="ttl">{title}</span>
    <span class="meta">
      <span>{label}</span>
      <span>{fmtDate(date)}</span>
      {minutes && <span>{minutes} MIN</span>}
    </span>
    {showDek && dek && <p class="dek">{dek}</p>}
  </a>
</li>
